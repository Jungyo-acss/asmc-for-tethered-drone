    <joint name="joint_left" type="revolute">
      <parent>winch_left</parent>
      <child>winch_central</child>
      <pose>0 0 0 0 0 0</pose> 
      <axis>
        <xyz>0 0 1</xyz> 
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
        <dynamics>
          <damping>0.3</damping>
          <friction>0.02</friction>
          <spring_stiffness>0.0</spring_stiffness>
          <spring_reference>0.0</spring_reference>
        </dynamics>
      </axis>
    </joint>

    <joint name="joint_right" type="revolute">
      <parent>winch_right</parent>
