    <link name="winch_central">
      <pose>0.6 0 1.0 0 1.5708 1.5708</pose>
      <inertial>
        <mass>2.0</mass>
        <inertia>
          <!-- Ixx = Iyy = (1/12)·m·(3r²+L²) -->
          <ixx>0.1717</ixx>
          <iyy>0.1717</iyy>
          <!-- Izz = (1/2)·m·r² -->
          <izz>0.0100</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>      
      <collision name="collision">
        <geometry>
          <cylinder>
            <length>1</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>      
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <min_depth>0.001</min_depth>
              <kp>1000</kp>
              <kd>1</kd>
            </ode>
          </contact>
        </surface>        
      </collision>
      <visual name="visual">
        <geometry>
          <cylinder>
            <length>1</length>
            <radius>0.1</radius>
          </cylinder>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Grey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <self_collide>1</self_collide>
    </link>

    <link name="winch_left">
      <pose>0.6 -0.5 1 0 0 1.5708</pose> 
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <!-- Ixx = (1/12)m(b²+c²)  b=c=0.5 -->
          <ixx>0.0208</ixx>
          <!-- Iyy = Izz = (1/12)m(a²+c²)  a=0.025, c=0.5 -->
          <iyy>0.0104</iyy>
          <izz>0.0104</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>            
      <collision name="collision">
        <geometry>
          <box>
            <size>0.025 0.5 0.5</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <ode>
          <min_depth>0.00005</min_depth>
          <kp>50000.0</kp>
          <kd>10.0</kd>   
            </ode>
          </contact>
          <friction>
            <ode>
          <mu>1.0</mu>
          <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.025 0.5 0.5</size>
          </box>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Grey</name>
            <uri>file://media/materials/scripts/gazebo.material</uri>
          </script>
        </material>
      </visual>
      <self_collide>1</self_collide>
    </link>

    <link name="winch_right">
      <pose>0.6 0.5 1 0 0 1.5708</pose>
      
      <inertial>
        <mass>0.5</mass>
        <inertia>
          <ixx>0.0208</ixx>
          <iyy>0.0104</iyy>
          <izz>0.0104</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
