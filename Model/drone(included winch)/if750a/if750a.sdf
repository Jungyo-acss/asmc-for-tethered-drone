      <axis>
        <xyz>0 1 0</xyz>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.0</friction>
          <spring_stiffness>0.01</spring_stiffness>
          <spring_reference>0.0</spring_reference>
        </dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis>
      <axis2>
        <xyz>0 0 1</xyz>
        <dynamics>
          <damping>0.05</damping>
          <friction>0.0</friction>
          <spring_stiffness>0.01</spring_stiffness>
          <spring_reference>0.0</spring_reference>
        </dynamics>
        <use_parent_model_frame>true</use_parent_model_frame>
      </axis2>
      <physics>
        <ode>
          <cfm_damping>1</cfm_damping>
        </ode>
      </physics>
    </joint>

